# Normalize line endings: Windows scripts and sources are CRLF, docs are LF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.cs text eol=crlf
*.csproj text eol=crlf
*.config text eol=crlf
*.manifest text eol=crlf
*.sln text eol=crlf
*.md  text eol=lf
*.json text eol=lf

# Binary assets must never be normalized.
*.ico binary
*.png binary
